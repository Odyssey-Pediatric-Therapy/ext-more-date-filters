{
  "name": "espocrm-ext-more-date-filters",
  "version": "1.2.0",
  "description": "",
  "scripts": {
    "sa": "php site/vendor/bin/phpstan analyse --debug --no-progress",
    "unit-tests": "php site/vendor/bin/phpunit --no-configuration --bootstrap tests/bootstrap.php --do-not-cache-result tests/unit",
    "integration-tests": "node build --copy && node build --composer-install && cd site && php vendor/bin/phpunit tests/integration/Espo/Modules/MoreDateFilters",
    "copy": "node build --copy",
    "composer-install": "node build --composer-install",
    "sync": "node build --copy && node build --composer-install",
    "extension": "node build --extension",
    "clear-cache": "php site/clear_cache.php",
    "rebuild": "node build --rebuild",
    "all": "node build --all",
    "prepare-test": "node build --prepare-test",
    "frontend-tests": "node --test tests/frontend/*.test.js",
    "seed": "php tests/seed-date-filters.php",
    "empty": "php tests/empty-date-filter-tables.php",
    "test-dependencies": "composer install --working-dir=tests --no-interaction --prefer-dist --no-plugins --no-scripts",
    "preseed": "npm run test-dependencies",
    "preunit-tests": "npm run test-dependencies"
  },
  "type": "module",
  "author": "Anthony Andriano",
  "dependencies": {
    "espo-extension-tools": "github:espocrm/extension-tools#0.3.6",
    "fs-extra": "^9.0.0"
  },
  "engines": {
    "npm": ">=11",
    "node": ">=24"
  }
}
